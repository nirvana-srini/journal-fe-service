{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionEventEnvelope",
  "type": "object",
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "type": { "type": "string" },
    "tenantId": { "type": "string" },
    "aggregateId": { "type": "string" },
    "payload": { "type": "object" }
  },
  "required": ["eventId","occurredAt","type","aggregateId"],
  "examples": [
    {
      "eventId": "c3d4e5f6-...",
      "traceId": "xyz789",
      "occurredAt": "2025-01-01T12:05:00Z",
      "type": "session.completed",
      "aggregateId": "3f5e7a9b-...",
      "payload": { "id": "3f5e7a9b-...", "actualEnd": "2025-01-01T12:25:00Z" }
    }
  ]
}